# Copy to .env.local and enter secrets locally, never in chat or Git.
ELEVENLABS_API_KEY=
ELEVENLABS_MALE_VOICE_ID=Ock0AL5DBkvTUDePt4Hm
ELEVENLABS_FEMALE_VOICE_ID=CKsJXR2wFcyN2C6OLGKK
# Optional second account used while the first free allowance is exhausted.
# The app prefers these when set; the original values remain the fallback.
ELEVENLABS_API_KEY_NEW=
ELEVENLABS_MALE_VOICE_ID_NEW=
ELEVENLABS_FEMALE_VOICE_ID_NEW=
# OpenAI-compatible planning provider. Current configuration: operator-provided DeepSeek gateway.
# Do not paste keys here; enter them in ignored .env.local only.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Some gateways require a provider prefix, for example ocg/deepseek-v4.1-flash.
# Planning stays blocked until the operator verifies the configured model and sets this true.
AI_FREE_TIER_VERIFIED=false
# Reserved server-only configuration; not used by the landing page.
MONGO_URL=
# Supabase Auth. Leave blank until a free project exists. Do not put the service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_GOOGLE_ENABLED=false
# Local RLS isolation test only. Never expose this key to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Amplify Hosting only inlines NEXT_PUBLIC_* values at build time, so the auth
# pages fall back to these when the server-only SUPABASE_* values are missing.
# Set the same project URL and publishable (anon) key here for deployed builds.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_GOOGLE_ENABLED=false
# Public media host. Set to the R2 custom domain (or another CDN origin) at build
# time so the landing and auth reels load from the CDN. Include the bucket
# prefix, for example https://media.example.com/videos. Empty means the local
# public/videos files are used. Never point this at a private bucket URL.
NEXT_PUBLIC_MEDIA_BASE_URL=
# Cloudflare R2, server-only. Never use a NEXT_PUBLIC_ prefix for these values
# and never paste them into chat or Git.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=
# Public bucket for landing/auth sample media only.
R2_BUCKET_NAME=vydrivo-media-prod
R2_PUBLIC_BASE_URL=
# Reserved private bucket for future user uploads; never expose it publicly.
R2_PRIVATE_BUCKET_NAME=vydrivo-user-media-private

# Private S3-compatible media (AWS S3 or R2). Prefer these generic names.
# For AWS S3 use MEDIA_S3_REGION=us-east-1 and
# MEDIA_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com.
MEDIA_S3_REGION=auto
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
