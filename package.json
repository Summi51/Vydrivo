{
  "name": "vydrivo-prototype",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "preflight": "node prototype/preflight.mjs",
    "test": "node --test prototype/*.test.mjs lib/*.test.mjs",
    "test:rls": "node --env-file-if-exists=.env.local prototype/rls-isolation.mjs",
    "compose": "node prototype/compose.mjs",
    "narrate": "node --env-file=.env.local prototype/narrate.mjs",
    "smoke": "node prototype/smoke.mjs",
    "plan": "node --env-file-if-exists=.env.local prototype/plan.mjs",
    "compile": "node prototype/compile.mjs",
    "render:timeline": "node prototype/render-timeline.mjs",
    "graphics:test": "node prototype/graphics-test.mjs",
    "graphics:explainer": "node prototype/graphics-explainer-render.mjs",
    "graphics:queue": "node --env-file-if-exists=.env.local prototype/graphics-queue-worker.mjs",
    "reel:hi:narrate": "node --env-file-if-exists=.env.local prototype/reel-narrate.mjs",
    "reel:hi": "node prototype/reel-render.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/s3-request-presigner": "^3.1162.0",
    "@remotion/bundler": "4.0.543",
    "@remotion/cli": "4.0.543",
    "@remotion/media": "4.0.543",
    "@remotion/renderer": "4.0.543",
    "@remotion/web-renderer": "4.0.543",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "next": "16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "eslint-config-next": "^16.4.6"
  }
}
