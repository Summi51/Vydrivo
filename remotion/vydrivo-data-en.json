{
  "schemaVersion": 1,
  "title": "Vydrivo — One idea to one finished video",
  "language": "en",
  "fps": 30,
  "width": 1080,
  "height": 1920,
  "durationInFrames": 2250,
  "footageCoverage": 0.7333,
  "scenes": [
    {
      "id": "scene-1",
      "kind": "footage",
      "title": "One idea",
      "kicker": "01 · THE IDEA",
      "durationInFrames": 300,
      "from": 0,
      "audio": "media/vydrivo/en/scene-1.mp3",
      "captions": [
        {
          "start": 0,
          "end": 2.485,
          "text": "It starts with one idea. You type it"
        },
        {
          "start": 2.485,
          "end": 4.969,
          "text": "once, in your own words. Describe the"
        },
        {
          "start": 4.969,
          "end": 8.336,
          "text": "mood. No timeline. No settings. Just"
        },
        {
          "start": 8.336,
          "end": 9.52,
          "text": "the scene you want."
        }
      ],
      "video": "media/vydrivo/footage/scene1-typing.mp4"
    },
    {
      "id": "scene-2",
      "kind": "system",
      "title": "The pipeline",
      "kicker": "02 · THE SYSTEM",
      "durationInFrames": 240,
      "from": 300,
      "audio": "media/vydrivo/en/scene-2.mp3",
      "captions": [
        {
          "start": 0,
          "end": 2.612,
          "text": "The browser sends the idea to the API."
        },
        {
          "start": 2.612,
          "end": 5.085,
          "text": "The API saves the project in the database"
        },
        {
          "start": 5.085,
          "end": 6.502,
          "text": "and calls a worker."
        }
      ]
    },
    {
      "id": "scene-3",
      "kind": "footage",
      "title": "Review the plan",
      "kicker": "03 · APPROVE",
      "durationInFrames": 360,
      "from": 540,
      "audio": "media/vydrivo/en/scene-3.mp3",
      "captions": [
        {
          "start": 0,
          "end": 1.688,
          "text": "Before anything is generated, you review"
        },
        {
          "start": 1.688,
          "end": 4.468,
          "text": "the scene cards. Each card is one shot:"
        },
        {
          "start": 4.468,
          "end": 6.114,
          "text": "what happens, how long, what the camera"
        },
        {
          "start": 6.114,
          "end": 8.55,
          "text": "sees. You can reorder a shot, shorten"
        },
        {
          "start": 8.55,
          "end": 11.18,
          "text": "a beat, or rewrite a line. You approve"
        },
        {
          "start": 11.18,
          "end": 11.97,
          "text": "the plan."
        }
      ],
      "video": "media/vydrivo/footage/scene3-review.mp4"
    },
    {
      "id": "scene-4",
      "kind": "footage",
      "title": "Render one scene",
      "kicker": "04 · THE WORKER",
      "durationInFrames": 540,
      "from": 900,
      "audio": "media/vydrivo/en/scene-4.mp3",
      "captions": [
        {
          "start": 0,
          "end": 1.672,
          "text": "The worker takes one approved scene"
        },
        {
          "start": 1.672,
          "end": 3.901,
          "text": "and renders it into moving footage."
        },
        {
          "start": 3.901,
          "end": 5.329,
          "text": "It also gets the narration and the"
        },
        {
          "start": 5.329,
          "end": 7.895,
          "text": "caption timing. It renders only that"
        },
        {
          "start": 7.895,
          "end": 10.588,
          "text": "scene. Narration and captions are measured"
        },
        {
          "start": 10.588,
          "end": 12.875,
          "text": "against the clip, so every word lands"
        },
        {
          "start": 12.875,
          "end": 14.687,
          "text": "on the right frame. The rest of the"
        },
        {
          "start": 14.687,
          "end": 16.022,
          "text": "video is untouched."
        }
      ],
      "video": "media/vydrivo/footage/scene4-editor.mp4"
    },
    {
      "id": "scene-5",
      "kind": "footage",
      "title": "One vertical video",
      "kicker": "05 · THE EXPORT",
      "durationInFrames": 450,
      "from": 1440,
      "audio": "media/vydrivo/en/scene-5.mp3",
      "captions": [
        {
          "start": 0,
          "end": 2.101,
          "text": "The pieces come together as one vertical"
        },
        {
          "start": 2.101,
          "end": 5.7,
          "text": "video. One file. Ten eighty by nineteen"
        },
        {
          "start": 5.7,
          "end": 9.242,
          "text": "twenty. No cropping, no reformatting."
        },
        {
          "start": 9.242,
          "end": 10.809,
          "text": "Narration and captions are already"
        },
        {
          "start": 10.809,
          "end": 13.491,
          "text": "in place. Ready for the phone, where"
        },
        {
          "start": 13.491,
          "end": 14.768,
          "text": "your audience already is."
        }
      ],
      "video": "media/vydrivo/footage/scene5-phone.mp4"
    },
    {
      "id": "scene-6",
      "kind": "revise",
      "title": "Change one scene",
      "kicker": "06 · REVISE",
      "durationInFrames": 360,
      "from": 1890,
      "audio": "media/vydrivo/en/scene-6.mp3",
      "captions": [
        {
          "start": 0,
          "end": 1.765,
          "text": "Change one scene, and only that scene"
        },
        {
          "start": 1.765,
          "end": 4.075,
          "text": "changes. Approve the new take, and"
        },
        {
          "start": 4.075,
          "end": 6.258,
          "text": "render again. The rest of the video"
        },
        {
          "start": 6.258,
          "end": 9.973,
          "text": "stays untouched. One idea in. One finished"
        },
        {
          "start": 9.973,
          "end": 11.331,
          "text": "MP4 out."
        }
      ]
    }
  ]
}